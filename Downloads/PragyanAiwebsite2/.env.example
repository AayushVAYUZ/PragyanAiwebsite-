# Contact form (/api/contact). Without RESEND_API_KEY and CONTACT_TO_EMAIL the form
# answers 503 and points visitors to the email address shown beside it.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives enquiries. Separate several addresses with commas.
CONTACT_TO_EMAIL=

# Optional. Sender address on a domain verified in Resend, e.g. "Pragyan ai <hello@yourdomain.com>".
# Defaults to Resend's test sender, which only delivers to the Resend account's own address.
CONTACT_FROM_EMAIL=
